<div class="layout layout--col gap--small">
  <div class="title_bar"><span class="title">📚 Tingsaker</span><span class="instance">{{ grade_1.week }}</span></div>
  <h2>1. trinn · {{ grade_1.today_day }}</h2>
  <div class="value">{% if grade_1.today_homework %}{{ grade_1.today_homework }}{% else %}Ingen lekser oppført.{% endif %}</div>
  <hr>
  <h2>4B · {{ grade_4b.today_day }}</h2>
  <div class="value">Lekser: {% if grade_4b.homework[grade_4b.today_day] %}{{ grade_4b.homework[grade_4b.today_day] }}{% else %}Ingen oppført.{% endif %}</div>
  {% if grade_4b.reminders[grade_4b.today_day] %}<div class="label">Husk: {{ grade_4b.reminders[grade_4b.today_day] }}</div>{% endif %}
  {% if grade_1.reminders[grade_1.today_day] and grade_1.reminders[grade_1.today_day] != "" %}<div class="label">1. trinn: ℹ️ {{ grade_1.reminders[grade_1.today_day] }}</div>{% endif %}
</div>